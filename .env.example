# ---------------------------------------------------------------------------
# Leo Portfolio — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical + Open Graph tags (Phase 11).
VITE_SITE_URL=https://your-domain.vercel.app

# Contact form endpoint (Phase 9). Pick ONE provider and paste its endpoint.
# Formspree: https://formspree.io/f/xxxxxxxx
# Web3Forms / Getform / your own API route also work.
VITE_CONTACT_ENDPOINT=

# EmailJS (only if you choose EmailJS instead of a plain POST endpoint).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
